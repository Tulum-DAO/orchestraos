#!/usr/bin/env bash
# Pre-push secret scan. Install with: git config core.hooksPath .git-hooks
set -euo pipefail

if ! command -v detect-secrets-hook >/dev/null 2>&1; then
  echo "pre-push: detect-secrets not installed (pip install detect-secrets) — skipping scan" >&2
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"
if ! detect-secrets-hook --baseline .secrets.baseline $(git ls-files); then
  echo "pre-push: new secrets detected that aren't in .secrets.baseline — blocking push." >&2
  echo "Review with: detect-secrets scan --all-files --baseline .secrets.baseline" >&2
  exit 1
fi
exit 0
