#!/usr/bin/env bash
# Pre-push secret scan. Install with: git config core.hooksPath .git-hooks
#
# Scans only the files the pushed commits touch (git hands each pushed ref to this hook on stdin).
# The whole tree is scanned when the baseline itself changed, or when no base can be found.
# Heavy scans share one machine-wide lock with any other gate that takes it
# (ORCHESTRA_GATE_LOCK, default ${XDG_RUNTIME_DIR:-/tmp}/orchestra-heavy-gate.lock): a second run
# prints who it is waiting for and queues instead of stacking on the CPU.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
# `orchestra init` pip-installs detect-secrets into <repo>/.venv, which is NOT on PATH in a
# normal shell — prefer the venv copy, fall back to PATH, only then skip (loudly).
HOOK=detect-secrets-hook
[ -x .venv/bin/detect-secrets-hook ] && HOOK=.venv/bin/detect-secrets-hook
if ! command -v "$HOOK" >/dev/null 2>&1; then
  echo "pre-push: detect-secrets not installed (run \`orchestra init\` or pip install detect-secrets) — skipping scan" >&2
  exit 0
fi

ZERO=0000000000000000000000000000000000000000
full=0
files=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                 # a branch deletion pushes no content
  base="$remote_sha"
  if [ "$base" = "$ZERO" ] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
    # A new branch: compare with where it left the default branch.
    base="$(git merge-base "$local_sha" origin/HEAD 2>/dev/null || git merge-base "$local_sha" origin/main 2>/dev/null || true)"
  fi
  if [ -z "$base" ]; then
    full=1
    continue
  fi
  while IFS= read -r f; do
    files+=("$f")
  done < <(git diff --name-only --diff-filter=ACMR "$base" "$local_sha")
done

for f in "${files[@]+"${files[@]}"}"; do
  [ "$f" = ".secrets.baseline" ] && full=1
done

if [ "$full" = 1 ]; then
  mapfile -t targets < <(git ls-files)
  what="the whole tree (${#targets[@]} files)"
else
  targets=()
  for f in "${files[@]+"${files[@]}"}"; do
    [ -f "$f" ] && targets+=("$f")
  done
  if [ "${#targets[@]}" -eq 0 ]; then
    exit 0
  fi
  what="${#targets[@]} changed file(s)"
fi

LOCK="${ORCHESTRA_GATE_LOCK:-${XDG_RUNTIME_DIR:-/tmp}/orchestra-heavy-gate.lock}"
exec 9>>"$LOCK"
if ! flock -n 9; then
  echo "pre-push: waiting for the heavy-gate lock held by pid $(cat "$LOCK.pid" 2>/dev/null || echo '?') ($LOCK)" >&2
  flock 9
fi
echo $$ > "$LOCK.pid"

echo "pre-push: secret scan of $what" >&2
if ! "$HOOK" --baseline .secrets.baseline "${targets[@]}"; then
  echo "pre-push: new secrets detected that aren't in .secrets.baseline — blocking push." >&2
  echo "Review with: detect-secrets scan --all-files --baseline .secrets.baseline" >&2
  exit 1
fi
exit 0
